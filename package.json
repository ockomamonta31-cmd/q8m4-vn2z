{
  "name": "match-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.mjs",
    "replay:parser": "docker compose -f server/parser-compose.yml up -d",
    "replay:fetch": "node server/gc/parse-replay.mjs",
    "replay:normalize": "node server/gc/normalize-replay.mjs",
    "replay:auto": "node server/gc/auto-ingest.mjs",
    "replay:github": "node server/gc/github-ingest.mjs",
    "gen-constants": "node server/gen-constants.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cf:types": "wrangler types"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "dota2": "^7.0.3",
    "globaloffensive": "^3.3.0",
    "steam-user": "^5.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "wrangler": "^4.149.0"
  }
}
