# Ключ Steam Web API (бесплатно): https://steamcommunity.com/dev/apikey
# Нужен своему API-серверу (server/index.mjs), он ходит напрямую в Valve.
STEAM_WEB_API_KEY=

# Random server-only secret for signing Steam login sessions; never expose to Vite.
AUTH_SECRET=

# Replay timeline upload destination (Cloudflare Worker).
REPLAY_INGEST_URL=
REPLAY_INGEST_TOKEN=

# Server-only replay metadata sources. GitHub Actions uses the same secrets.
# Dedicated Steam bot refresh token (never use a VITE_ prefix).
STRATZ_API_TOKEN=
STEAM_REFRESH_TOKEN=

# Режим демо-данных (работает без ключа, для просмотра интерфейса)
# VITE_DEMO=1
