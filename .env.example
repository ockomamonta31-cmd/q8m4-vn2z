# Ключ Steam Web API (бесплатно): https://steamcommunity.com/dev/apikey
# Нужен своему API-серверу (server/index.mjs), он ходит напрямую в Valve.
STEAM_WEB_API_KEY=

# Replay timeline upload destination (Cloudflare Worker).
REPLAY_INGEST_URL=
REPLAY_INGEST_TOKEN=

# Режим демо-данных (работает без ключа, для просмотра интерфейса)
# VITE_DEMO=1
